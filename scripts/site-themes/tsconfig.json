// For tsx only (npx tsx --tsconfig scripts/site-themes/tsconfig.json …): the root paths, plus server-only as the
// empty module (as vitest maps it), and the automatic JSX runtime for the code engine's parts.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": "../..",
    "paths": {
      "server-only": ["./node_modules/next/dist/compiled/server-only/empty.js"],
      "@/*": ["./packages/store-core/src/*"],
      "@controller/*": ["./controller-service/src/*"],
      "@storefront/*": ["./storefront-service/src/*"],
      "@admin/*": ["./admin-service/src/*"],
      "@business/*": ["./business-service/src/*"],
      "@showcase/*": ["./showcase-service/src/*"]
    }
  }
}
