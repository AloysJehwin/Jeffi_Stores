{
  "org": "Jeffi-ERP",
  "upstream": { "repo": "AloysJehwin/Jeffi_Stores", "branch": "main" },
  "promote": { "base": "main" },
  "label": "ok-to-test",
  "maintainers": "maintainers",
  "owner": "AloysJehwin",
  "homepage": "https://jeffistores.in",
  "apps": { "export": 5836021, "promote": 5836027 },
  "managed": [".github/", "LICENSE"],
  "env": {
    "test": {
      "JWT_SECRET": "test-jwt-secret-at-least-32-bytes!!",
      "CRON_SECRET": "test-cron-secret",
      "SERVICE_AUTH_SECRET": "test-service-auth-secret",
      "RAZORPAY_WEBHOOK_SECRET": "test-webhook-secret",
      "DELHIVERY_API_KEY": "test-delhivery-key",
      "GOOGLE_CLIENT_ID": "test-google-client-id"
    },
    "build": {
      "NODE_OPTIONS": "--max-old-space-size=6144",
      "DATABASE_URL": "postgresql://localhost:5432/dummy",
      "JWT_SECRET": "ci-test-secret",
      "NEXT_PUBLIC_APP_URL": "http://localhost:3000",
      "SKIP_DB_CHECK": "true"
    }
  },
  "repos": [
    {
      "name": "workspace",
      "path": "",
      "include": [
        "package.json", "package-lock.json", "tsconfig.json", "tsconfig.services.json",
        "vitest.config.ts", "vitest.integration.config.ts", "playwright.config.ts",
        ".eslintrc.services.cjs", ".editorconfig", ".gitignore", ".prettierrc.json", ".prettierignore", ".env.example",
        "scripts/db-files.mjs", "scripts/check-api-test-mirror.mjs", "scripts/gen-admin-manifest.ts",
        "scripts/admin-manifest/", "scripts/dev-router.ts", "scripts/site-themes/",
        "database/", "tests/", "vendor/", "certs/", "deploy/load-secrets.mjs"
      ],
      "managed": ["oss/"],
      "description": "Start here: shared root config (package.json, tsconfig, Vitest, ESLint), the DB schema loader, and oss/assemble.mjs, which clones every Jeffi ERP repo into place.",
      "topics": ["jeffi-erp", "monorepo", "workspace", "nextjs", "typescript", "ecommerce"],
      "discussions": true,
      "checks": {
        "pr": [
          { "name": "Type check (everything)", "run": "npx tsc --noEmit" },
          { "name": "Admin API manifest", "run": "npm run cli:check" },
          { "name": "API test mirror", "run": "node scripts/check-api-test-mirror.mjs" }
        ],
        "prebuild": [
          { "name": "Type check (everything)", "run": "npx tsc --noEmit" },
          { "name": "Admin API manifest", "run": "npm run cli:check" }
        ],
        "build": [
          { "name": "Unit tests · store-core", "run": "npx vitest run --project store-core", "env": "test" },
          { "name": "Build · controller", "run": "npm run build:controller", "env": "build" }
        ]
      }
    },
    {
      "name": "storefront-service",
      "path": "storefront-service",
      "description": "Customer storefront (Next.js): catalogue, search, cart, checkout and accounts.",
      "topics": ["jeffi-erp", "ecommerce", "storefront", "nextjs", "react", "typescript"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx next lint storefront-service" },
          { "name": "Type check", "run": "npx tsc --noEmit -p storefront-service/tsconfig.typecheck.json" },
          { "name": "Unit tests", "run": "npx vitest run --project storefront --passWithNoTests", "env": "test" }
        ],
        "prebuild": [
          { "name": "Lint", "run": "npx next lint storefront-service" },
          { "name": "Type check", "run": "npx tsc --noEmit -p storefront-service/tsconfig.typecheck.json" }
        ],
        "build": [
          { "name": "Unit tests", "run": "npx vitest run --project storefront --passWithNoTests", "env": "test" },
          { "name": "Build", "run": "npm run build:storefront", "env": "build" }
        ]
      }
    },
    {
      "name": "admin-service",
      "path": "admin-service",
      "description": "Store admin panel (Next.js): products, orders, invoices, GST, CRM and campaigns.",
      "topics": ["jeffi-erp", "ecommerce", "admin-panel", "erp", "nextjs", "typescript"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx next lint admin-service" },
          { "name": "Type check", "run": "npx tsc --noEmit -p admin-service/tsconfig.typecheck.json" },
          { "name": "Unit tests", "run": "npx vitest run --project admin --passWithNoTests", "env": "test" }
        ],
        "prebuild": [
          { "name": "Lint", "run": "npx next lint admin-service" },
          { "name": "Type check", "run": "npx tsc --noEmit -p admin-service/tsconfig.typecheck.json" }
        ],
        "build": [
          { "name": "Unit tests", "run": "npx vitest run --project admin --passWithNoTests", "env": "test" },
          { "name": "Build", "run": "npm run build:admin", "env": "build" }
        ]
      }
    },
    {
      "name": "business-service",
      "path": "business-service",
      "description": "B2B portal (Next.js): business accounts, RFQs, quotations and bulk ordering.",
      "topics": ["jeffi-erp", "ecommerce", "b2b", "nextjs", "typescript"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx next lint business-service" },
