        "build": [
          { "name": "Unit tests", "run": "npx vitest run --project business --passWithNoTests", "env": "test" },
          { "name": "Build", "run": "npm run build:business", "env": "build" }
        ]
      }
    },
    {
      "name": "controller-service",
      "path": "controller-service",
      "description": "Platform control plane (Next.js): tenants, provisioning, plans, billing and the ecom portal.",
      "topics": ["jeffi-erp", "saas", "multi-tenant", "control-plane", "nextjs", "typescript"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx next lint controller-service --dir src" },
          { "name": "Type check", "run": "npx tsc --noEmit -p controller-service/tsconfig.typecheck.json" },
          { "name": "Unit tests", "run": "npx vitest run --project controller --passWithNoTests", "env": "test" }
        ],
        "prebuild": [
          { "name": "Lint", "run": "npx next lint controller-service --dir src" },
          { "name": "Type check", "run": "npx tsc --noEmit -p controller-service/tsconfig.typecheck.json" }
        ],
        "build": [
          { "name": "Unit tests", "run": "npx vitest run --project controller --passWithNoTests", "env": "test" },
          { "name": "Build", "run": "npm run build:controller", "env": "build" }
        ]
      }
    },
    {
      "name": "showcase-service",
      "path": "showcase-service",
      "description": "One-page business websites (Next.js).",
      "topics": ["jeffi-erp", "website-builder", "nextjs", "typescript"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx next lint showcase-service" },
          { "name": "Type check", "run": "npx tsc --noEmit -p showcase-service/tsconfig.typecheck.json" },
          { "name": "Unit tests", "run": "npx vitest run --project showcase --passWithNoTests", "env": "test" }
