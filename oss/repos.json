          { "name": "Build", "run": "npm run build:showcase", "env": "build" }
        ]
      }
    },
    {
      "name": "messaging-service",
      "path": "messaging-service",
      "description": "WhatsApp, SMS, email and push messaging: templates, sending and delivery tracking.",
      "topics": ["jeffi-erp", "whatsapp", "sms", "email", "push-notifications", "typescript"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts messaging-service/src" },
          { "name": "Type check", "run": "npm --prefix messaging-service run typecheck" },
          { "name": "Unit tests", "run": "npm --prefix messaging-service test", "env": "test" }
