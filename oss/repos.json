          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts document-service/src" },
          { "name": "Type check", "run": "npm --prefix document-service run typecheck" }
        ],
        "build": [
          { "name": "Unit tests", "run": "npm --prefix document-service test", "env": "test" }
        ]
      }
    },
    {
      "name": "public-api-service",
      "path": "public-api-service",
      "description": "Public REST API (/v1) for stores and integrations.",
      "topics": ["jeffi-erp", "rest-api", "ecommerce-api", "typescript"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts public-api-service/src" },
          { "name": "Type check", "run": "npm --prefix public-api-service run typecheck" },
          { "name": "Unit tests", "run": "npm --prefix public-api-service test -- --passWithNoTests", "env": "test" }
        ],
        "prebuild": [
          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts public-api-service/src" },
          { "name": "Type check", "run": "npm --prefix public-api-service run typecheck" }
        ],
        "build": [
          { "name": "Unit tests", "run": "npm --prefix public-api-service test -- --passWithNoTests", "env": "test" }
        ]
      }
    },
    {
      "name": "mobile-service",
      "path": "mobile-service",
      "description": "Mobile backend API and the Expo (React Native) shopping app.",
      "topics": ["jeffi-erp", "react-native", "expo", "mobile-app", "typescript"],
      "exclude": ["client/google-services.json"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts mobile-service/src" },
          { "name": "Type check", "run": "npm --prefix mobile-service run typecheck" },
          { "name": "Unit tests", "run": "npm --prefix mobile-service test -- --passWithNoTests", "env": "test" },
          { "name": "App type check", "run": "npm --prefix mobile-service/client ci && npm --prefix mobile-service/client run typecheck" }
        ],
        "prebuild": [
          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts mobile-service/src" },
          { "name": "Type check", "run": "npm --prefix mobile-service run typecheck" },
          { "name": "App type check", "run": "npm --prefix mobile-service/client ci && npm --prefix mobile-service/client run typecheck" }
        ],
        "build": [
          { "name": "Unit tests", "run": "npm --prefix mobile-service test -- --passWithNoTests", "env": "test" }
        ]
      }
    },
    {
      "name": "ai-platform",
      "path": "ai-platform",
      "description": "AI gateway and SDK: chat, embeddings, vision and OCR with caching and a durable queue.",
      "topics": ["jeffi-erp", "ai-gateway", "llm", "ollama", "ocr", "typescript"],
      "exclude": ["deploy/"],
      "checks": {
        "pr": [
          { "name": "Install", "run": "npm --prefix ai-platform ci" },
          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts ai-platform/gateway/src ai-platform/sdk" },
          { "name": "Type check", "run": "npm --prefix ai-platform run typecheck" },
          { "name": "Unit tests", "run": "npm --prefix ai-platform test" }
        ],
        "prebuild": [
          { "name": "Install", "run": "npm --prefix ai-platform ci" },
          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts ai-platform/gateway/src ai-platform/sdk" },
          { "name": "Type check", "run": "npm --prefix ai-platform run typecheck" }
        ],
        "build": [
          { "name": "Install", "run": "npm --prefix ai-platform ci" },
          { "name": "Unit tests", "run": "npm --prefix ai-platform test" },
          { "name": "Build", "run": "npm --prefix ai-platform run build" }
        ]
      }
    },
    {
      "name": "store-core",
      "path": "packages/store-core",
      "description": "Shared core of the Next.js apps: UI components, domain logic, database access, auth and middleware.",
      "topics": ["jeffi-erp", "ecommerce", "nextjs", "react", "typescript"],
      "exclude": [
        "tests/lib/razorpay-route-payload.test.ts",
        "tests/lib/shipping/courier-consignee.test.ts",
        "tests/lib/showcase-complete.test.ts"
      ],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx next lint controller-service --dir ../packages/store-core/src" },
          { "name": "Type check", "run": "npx tsc --noEmit -p packages/store-core/tsconfig.typecheck.json" },
          { "name": "Unit tests", "run": "npx vitest run --project store-core", "env": "test" }
        ],
        "prebuild": [
          { "name": "Lint", "run": "npx next lint controller-service --dir ../packages/store-core/src" },
          { "name": "Type check", "run": "npx tsc --noEmit -p packages/store-core/tsconfig.typecheck.json" },
          { "name": "Type check · admin", "run": "npx tsc --noEmit -p admin-service/tsconfig.typecheck.json" },
          { "name": "Type check · storefront", "run": "npx tsc --noEmit -p storefront-service/tsconfig.typecheck.json" }
        ],
        "build": [
          { "name": "Unit tests", "run": "npx vitest run --project store-core", "env": "test" },
          { "name": "Build · storefront", "run": "npm run build:storefront", "env": "build" }
        ]
      }
    },
    {
      "name": "packages",
      "path": "packages",
      "description": "Shared TypeScript packages: tenancy, service auth, pricing, GST, wallet, push, bulk jobs, the CLI and more.",
      "topics": ["jeffi-erp", "typescript", "npm-workspaces", "cli"],
      "exclude": ["store-core/"],
      "checks": {
        "pr": [
          { "name": "Type check · cli", "run": "npx tsc --noEmit -p packages/cli/tsconfig.json" },
