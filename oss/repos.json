          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts messaging-service/src" },
          { "name": "Type check", "run": "npm --prefix messaging-service run typecheck" }
        ],
        "build": [
          { "name": "Unit tests", "run": "npm --prefix messaging-service test", "env": "test" }
        ]
      }
    },
    {
      "name": "document-service",
      "path": "document-service",
      "description": "PDF documents: invoices, quotations, purchase orders and receipts.",
      "topics": ["jeffi-erp", "pdf", "invoicing", "gst", "typescript"],
      "checks": {
        "pr": [
          { "name": "Lint", "run": "npx eslint --no-eslintrc -c .eslintrc.services.cjs --ext .ts document-service/src" },
          { "name": "Type check", "run": "npm --prefix document-service run typecheck" },
          { "name": "Unit tests", "run": "npm --prefix document-service test", "env": "test" }
