# =============================================================================
# Jeffi Stores — Environment Variables (template)
# Copy to .env.local for development, .env.production on EC2 for deploy.
# Required for prod marked [REQUIRED]; optional/feature-gated marked [OPTIONAL].
# =============================================================================

# ---- Database [REQUIRED] ----
# Local dev:  postgresql://user@localhost:5432/jeffi_production_ready
# Production: RDS endpoint (private subnet, only EC2 reaches it)
DATABASE_URL=postgresql://user:password@host:5432/jeffi_stores

# ---- App URLs [REQUIRED] ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3000/admin
NODE_ENV=development

# ---- Auth / Security [REQUIRED] ----
JWT_SECRET=change-me-to-a-strong-random-string-min-32-chars
MFA_ENCRYPTION_KEY=change-me-to-a-64-hex-string-or-any-passphrase-min-32-chars
CRON_SECRET=change-me-cron-shared-secret

# ---- AWS S3 (product images, gallery) [REQUIRED] ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=jeffi-stores-bucket
S3_KEY_PREFIX=dev
CLOUDFRONT_URL=https://d111111abcdef8.cloudfront.net

# ---- Image processing [OPTIONAL — has defaults] ----
MAX_IMAGES_PER_PRODUCT=5
THUMBNAIL_SIZE=300
MAX_IMAGE_SIZE=2097152

# ---- AWS SES (transactional email) [REQUIRED for prod] ----
SES_SMTP_USER=your-ses-smtp-username
SES_SMTP_PASSWORD=your-ses-smtp-password
SES_FROM_EMAIL=noreply@jeffistores.in
SES_ADMIN_FROM_EMAIL=noreply@admin.jeffistores.in
# Account's SES sending rate (emails/second). Raise only after AWS approves the quota increase.
SES_MAX_SEND_RATE=14
ADMIN_EMAIL=admin@jeffistores.in
SUPPORT_EMAIL=support@jeffistores.in

# ---- App push (FCM) [OPTIONAL] ----
# Firebase service account (raw JSON or base64); used in-process when MESSAGING_INLINE is not 'false'.
FCM_SERVICE_ACCOUNT_JSON=

# ---- Razorpay (customer payments) [REQUIRED if ENABLE_RAZORPAY=true] ----
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
ENABLE_RAZORPAY=false
NEXT_PUBLIC_ENABLE_RAZORPAY=false
# Fallback for the platform's UPI ID (site setting upi_vpa wins)
RAZORPAY_UPI_VPA=your-upi-vpa@bank

# ---- UPI: the platform's PhonePe PG v2 account [OPTIONAL: can also be saved in Site Controls; without it the platform collects on its UPI ID] ----
# sandbox or production
PHONEPE_ENV=sandbox
# Client credentials from the PhonePe Business dashboard (Developer settings)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Shown on the account card only
PHONEPE_MERCHANT_ID=
# Username/password set on the PhonePe webhook; the callback's Authorization is SHA256(username:password)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Default for the Site Controls "UPI payments" switch; an explicit false also switches UPI off platform-wide
ENABLE_UPI=false
# UPG (pay to a UPI ID, confirmed from the bank's credit-alert email). The secret signs each merchant's
# upi+<slug>.<token>@<REPLY_MAIL_DOMAIN> forwarding address; without it no address is issued.
UPG_ALERT_SECRET=
# Seconds a payer holds the UPI ID, and seconds we look for the bank alert after "check my payment"
UPG_PAY_SECONDS=300
UPG_VERIFY_SECONDS=30

# ---- Delhivery (shipping) [OPTIONAL] ----
DELHIVERY_API_KEY=
DELHIVERY_ORIGIN_PINCODE=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_SELLER_NAME=
DELHIVERY_SELLER_PHONE=
DELHIVERY_SELLER_ADDRESS=

# ---- GST / E-Invoice / E-Way Bill [OPTIONAL — currently inactive] ----
ENABLE_GST=false
NEXT_PUBLIC_ENABLE_GST=false
BUSINESS_STATE_CODE=22
EINVOICE_BASE_URL=
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=
EINVOICE_GSTIN=
EWAYBILL_BASE_URL=
EWAYBILL_CLIENT_ID=
EWAYBILL_CLIENT_SECRET=
EWAYBILL_USERNAME=
EWAYBILL_PASSWORD=
EWAYBILL_GSTIN=

# ---- Google services [OPTIONAL] ----
# OAuth login + Maps autocomplete (frontend-visible)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Service account inline (alternative to jeffi-stores-76e9ecaecdd6.json file)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Full service account JSON as single-line string (used by Sheets + Merchant Center)
# Run: cat jeffi-stores-76e9ecaecdd6.json | tr -d '\n' to get the value
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Merchant feed token — set to lock down /api/feed/google (optional)
FEED_SECRET=

# ---- Meta (Social Posts, Meta Ads, Conversions API) [OPTIONAL] ----
# The platform Meta app; a store can use its own app instead (Social or Meta Ads gear).
META_APP_ID=
META_APP_SECRET=
# Graph API version for every Meta call (default v27.0)
META_GRAPH_VERSION=
# Facebook Login for Business configuration ids (Business-type apps); classic apps leave them blank
META_LOGIN_CONFIG_ID=
META_ADS_LOGIN_CONFIG_ID=
# 32-byte key (64 hex chars or base64) that encrypts stored social / integration tokens
SOCIAL_TOKEN_ENC_KEY=

# ---- OpenAI (admin tooling) [OPTIONAL] ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- AI Provider Selection [OPTIONAL] ----
# AI_PROVIDER controls which LLM serves /api/admin/campaigns/generate and
# /api/admin/campaigns/scenarios/generate. Default is openai.
# Set to "ollama" to route requests to a self-hosted Ollama server (e.g. a
# GPU laptop on your Tailscale network). Falls back to OpenAI on failure
# when OLLAMA_FALLBACK_TO_OPENAI=true.
AI_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_AGENT_MODEL=qwen3:14b
OLLAMA_SQL_MODEL=qwen3:14b
OLLAMA_COPY_MODEL=qwen3:14b
# Customer email copy generation — small/fast model that returns complete valid JSON.
OLLAMA_EMAIL_MODEL=gemma3:4b
OLLAMA_FALLBACK_TO_OPENAI=true

# ---- PaddleOCR sidecar (quotation file OCR) [OPTIONAL] ----
# Run: python scripts/ocr_service.py
# Falls back to Ollama vision model if this service is not running.
PADDLE_OCR_URL=http://localhost:8866

# ---- Redis / Cache [OPTIONAL] ----
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- API Gateway WebSocket (real-time support chat) [OPTIONAL] ----
WS_API_ID=
WS_REGION=us-east-1
