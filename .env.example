# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/jeffi_stores

# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=jeffi-stores
S3_KEY_PREFIX=dev

# Image Processing
MAX_IMAGES_PER_PRODUCT=5
THUMBNAIL_SIZE=300
MAX_IMAGE_SIZE=2097152

# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# JWT Secret (for custom auth if needed)
JWT_SECRET=your-jwt-secret-key-change-this

# Email Configuration (AWS SES SMTP)
SES_SMTP_USER=your-ses-smtp-username
SES_SMTP_PASSWORD=your-ses-smtp-password
SES_FROM_EMAIL=noreply@yourdomain.com
SES_ADMIN_FROM_EMAIL=noreply@admin.yourdomain.com
ADMIN_EMAIL=admin@admin.yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# GST & Invoicing
ENABLE_GST=false
NEXT_PUBLIC_ENABLE_GST=false
BUSINESS_STATE_CODE=22
