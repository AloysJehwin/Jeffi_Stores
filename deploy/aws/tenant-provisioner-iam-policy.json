{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TenantParameterGroups",
      "Effect": "Allow",
      "Action": ["rds:CreateDBParameterGroup", "rds:ModifyDBParameterGroup", "rds:DeleteDBParameterGroup"],
      "Resource": "arn:aws:rds:us-east-1:708835965056:pg:jeffi-tenant-*"
    },
    {
      "Sid": "TenantDatabases",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:DeleteDBInstance",
        "rds:StopDBInstance",
        "rds:StartDBInstance",
        "rds:ModifyDBInstance",
        "rds:AddTagsToResource",
        "rds:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rds:us-east-1:708835965056:db:jeffi-tenant-*",
        "arn:aws:rds:us-east-1:708835965056:pg:jeffi-tenant-*",
        "arn:aws:rds:us-east-1:708835965056:subgrp:*"
      ]
    },
    {
      "Sid": "RdsReadOnlyDescribesCannotBeResourceScoped",
      "Effect": "Allow",
      "Action": ["rds:DescribeDBInstances", "rds:DescribeDBParameterGroups", "rds:DescribeDBSubnetGroups"],
      "Resource": "*"
    },
    {
      "Sid": "Ec2ReadOnlyDescribesCannotBeResourceScoped",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeImages",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchTenantInstancesMustCarryTheTenantTag",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:708835965056:instance/*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/app": ["jeffi-tenant", "jeffi-k8s"] }
      }
    },
    {
      "Sid": "LaunchTenantInstancesSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:708835965056:subnet/*",
        "arn:aws:ec2:us-east-1:708835965056:security-group/*",
        "arn:aws:ec2:us-east-1:708835965056:network-interface/*",
        "arn:aws:ec2:us-east-1:708835965056:volume/*",
        "arn:aws:ec2:us-east-1:708835965056:key-pair/*"
      ]
    },
    {
      "Sid": "TagOnlyAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1:708835965056:*/*",
      "Condition": {
        "StringEquals": { "ec2:CreateAction": ["RunInstances", "CreateVolume", "CreateSnapshot"] }
      }
    },
    {
      "Sid": "ManageOnlyTaggedTenantInstances",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances", "ec2:TerminateInstances", "ec2:ModifyInstanceAttribute"],
      "Resource": "arn:aws:ec2:us-east-1:708835965056:instance/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/app": ["jeffi-tenant", "jeffi-k8s"] }
      }
    },
    {
      "Sid": "CreateStoreDatabaseVolumesMustCarryTheDbTag",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:us-east-1:708835965056:volume/*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/jeffi:role": "db" }
      }
    },
    {
      "Sid": "ManageOnlyStoreDatabaseVolumes",
      "Effect": "Allow",
      "Action": ["ec2:AttachVolume", "ec2:DetachVolume", "ec2:ModifyVolume", "ec2:DeleteVolume", "ec2:CreateSnapshot"],
      "Resource": "arn:aws:ec2:us-east-1:708835965056:volume/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/jeffi:role": "db" }
      }
    },
    {
      "Sid": "AttachDatabaseVolumesOnlyToStoreServers",
      "Effect": "Allow",
      "Action": ["ec2:AttachVolume", "ec2:DetachVolume"],
      "Resource": "arn:aws:ec2:us-east-1:708835965056:instance/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/app": "jeffi-k8s" }
      }
    },
    {
      "Sid": "SnapshotsMustCarryTheTenantTag",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": "arn:aws:ec2:us-east-1::snapshot/*",
      "Condition": {
        "Null": { "aws:RequestTag/jeffi-tenant": "false" }
      }
    },
    {
      "Sid": "TenantSecurityGroupIngressOnly",
      "Effect": "Allow",
      "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"],
      "Resource": [
        "arn:aws:ec2:us-east-1:708835965056:security-group/sg-0f4f1f26371fe723d",
        "arn:aws:ec2:us-east-1:708835965056:security-group/sg-0e361f0f1b093bd83"
      ]
    },
    {
      "Sid": "PassTenantInstanceRoleToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::708835965056:role/jeffi-tenant-app-role",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" }
      }
    },
    {
      "Sid": "StoreDatabasePasswords",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:DeleteSecret",
        "secretsmanager:RestoreSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:708835965056:secret:jeffi/tenant-db/*"
    },
    {
      "Sid": "TenantBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketCORS",
        "s3:PutBucketPolicy",
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::jeffi-tenant-*"
    },
    {
      "Sid": "StoreDatabaseBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::jeffi-stores-bucket/tenant-backups/*"
    },
    {
      "Sid": "ListStoreDatabaseBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::jeffi-stores-bucket",
      "Condition": {
        "StringLike": { "s3:prefix": "tenant-backups/*" }
      }
    },
    {
      "Sid": "TenantDnsRecordsInJeffistoresZoneOnly",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z08094881XKVZ9XSGBKG1"
    },
    {
      "Sid": "Route53ReadBack",
      "Effect": "Allow",
      "Action": ["route53:GetChange", "route53:ListHostedZones", "route53:ListResourceRecordSets"],
      "Resource": "*"
    }
  ]
}
