    { "Sid": "ListFleetConfigPrefix", "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::jeffi-stores-mtls-truststore" },
    { "Sid": "WhatsAppTemplates", "Effect": "Allow", "Action": ["social-messaging:CreateWhatsAppMessageTemplate", "social-messaging:UpdateWhatsAppMessageTemplate", "social-messaging:DeleteWhatsAppMessageTemplate"], "Resource": "*" }
  ]
}
