# Keys for the voice E2E harness (python tests/voice-e2e/run.py --live-keys).
# The harness reads ~/.jeffi/voice-e2e.env (mode 600, outside the repo) first; this file, copied to
# voice-service/.env.e2e.local (gitignored), overrides it field by field. Values are never printed.
# Spend is capped (--max-minutes, default 15 call minutes).
SARVAM_API_KEY=
# Claude goes through workload identity federation, not an API key. Mint a fresh 1h token before a live run:
#   node ai-platform/scripts/local-wif-token.mjs mint   (--watch for long runs)
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=
# Optional; defaults to claude-haiku-5-5.
VOICE_LLM_MODEL=
