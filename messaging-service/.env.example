PORT=3101
# One shared DB today (microservices phase 1: services split, DB unified). See docs/MICROSERVICES.md.
MESSAGING_DATABASE_URL=postgresql://user:pass@localhost:5432/jeffi_production_ready
CONTROL_PLANE_DATABASE_URL=postgresql://user:pass@localhost:5432/jeffi_production_ready
SERVICE_AUTH_SECRET=change-me
PUBLIC_BASE_URL=https://public.jeffistores.in
PLATFORM_DOMAIN=jeffistores.in
SES_SMTP_USER=
SES_SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# Firebase service account (raw JSON or base64) for app push over FCM; empty disables push.
FCM_SERVICE_ACCOUNT_JSON=
# AWS End User Messaging (tenants the provider policy puts on AWS). Unset ids = not configured.
AWS_MESSAGING_REGION=
AWS_WHATSAPP_PHONE_NUMBER_ID=
AWS_WHATSAPP_WABA_ID=
AWS_WHATSAPP_META_API_VERSION=v20.0
AWS_SMS_ORIGINATION=
AWS_SMS_CONFIGURATION_SET=
AWS_SMS_DLT_ENTITY_ID=
