{
  "name": "messaging-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "predev": "SM_SECRET_ID=${SM_SECRET_ID:-jeffi/messaging/local} ENV_OUT_DIR=. node ../deploy/load-secrets.mjs",
    "seed:catalog": "node --env-file=.env.local --import tsx scripts/seed-catalog.ts",
    "wa:sync": "node --env-file=.env.local --import tsx scripts/wa-approval-sync.ts",
    "wa:resubmit": "node --env-file=.env.local --import tsx scripts/resubmit-wa-templates.ts",
    "wa:shift-action-bodies": "node --env-file=.env.local --import tsx scripts/shift-wa-action-bodies.ts",
    "wa:brand-token": "node --env-file=.env.local --import tsx scripts/wa-brand-token.ts"
  },
  "dependencies": {
    "@aws-sdk/client-pinpoint-sms-voice-v2": "3.1071.0",
    "@aws-sdk/client-secrets-manager": "^3.1110.0",
    "@aws-sdk/client-socialmessaging": "3.1071.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@jeffi/api-contracts": "*",
    "@jeffi/bulk": "*",
    "@jeffi/mail-shell": "*",
    "@jeffi/pricing": "*",
    "@jeffi/push": "*",
    "@jeffi/service-auth": "*",
    "@jeffi/tenancy": "*",
    "@jeffi/wallet": "*",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.0",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "twilio": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
