{
  "name": "jeffi-stores",
  "version": "2.0.0",
  "license": "AGPL-3.0-only",
  "description": "Jeffi Stores - Industrial Hardware E-commerce Platform",
  "private": true,
  "scripts": {
    "predev": "node deploy/load-secrets.mjs",
    "dev": "concurrently -k -n router,store,admin,biz,ctrl -c gray,green,blue,magenta,yellow \"npm:dev:router\" \"npm:dev:app:storefront\" \"npm:dev:app:admin\" \"npm:dev:app:business\" \"npm:dev:app:controller\"",
    "dev:router": "tsx scripts/dev-router.ts",
    "dev:app:storefront": "next dev --turbopack -p 3010 storefront-service",
    "dev:app:admin": "next dev --turbopack -p 3011 admin-service",
    "dev:app:business": "next dev --turbopack -p 3012 business-service",
    "dev:app:controller": "next dev --turbopack -p 3013 controller-service",
    "dev:app:showcase": "next dev --turbopack -p 3014 showcase-service",
    "dev:storefront": "node deploy/load-secrets.mjs && concurrently -k -n router,store -c gray,green \"npm:dev:router\" \"npm:dev:app:storefront\"",
    "dev:admin": "node deploy/load-secrets.mjs && concurrently -k -n router,admin -c gray,blue \"npm:dev:router\" \"npm:dev:app:admin\"",
    "dev:business": "node deploy/load-secrets.mjs && concurrently -k -n router,biz -c gray,magenta \"npm:dev:router\" \"npm:dev:app:business\"",
    "dev:controller": "node deploy/load-secrets.mjs && concurrently -k -n router,ctrl -c gray,yellow \"npm:dev:router\" \"npm:dev:app:controller\"",
    "dev:showcase": "node deploy/load-secrets.mjs && concurrently -k -n router,site -c gray,cyan \"npm:dev:router\" \"npm:dev:app:showcase\"",
    "dev:https": "node controller-service/server.js",
    "build": "next build controller-service && next build storefront-service && next build admin-service && next build business-service && next build showcase-service",
    "build:storefront": "next build storefront-service",
    "build:admin": "next build admin-service",
    "build:business": "next build business-service",
    "build:controller": "next build controller-service",
    "build:showcase": "next build showcase-service",
    "lint": "next lint controller-service --dir src --dir ../packages/store-core/src && next lint storefront-service && next lint admin-service && next lint business-service && next lint showcase-service",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "API_DB=1 vitest run --config vitest.db.config.ts",
    "setup:test-db": "bash scripts/setup-test-db.sh",
    "sweep:responsive": "playwright test --config playwright.config.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "check:component-tests": "node scripts/check-component-tests.mjs",
    "check:route-tests": "node scripts/check-route-tests.mjs",
    "test:ui:editor": "SITE_EDITOR_E2E=1 playwright test --config playwright.ui.config.ts storefront-service/ui-tests/site-editor admin-service/ui-tests/site-editor",
    "test:ui:kit": "UI_APP=kit playwright test -c playwright.ui.config.ts",
    "test:post-deploy": "playwright test -c playwright.post-deploy.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:messaging": "npm --prefix messaging-service run dev",
    "dev:documents": "npm --prefix document-service run dev",
    "dev:public-api": "npm --prefix public-api-service run dev",
    "dev:services": "concurrently -n msg,doc,api -c blue,green,magenta \"npm run dev:messaging\" \"npm run dev:documents\" \"npm run dev:public-api\"",
    "typecheck:services": "npm --prefix messaging-service run typecheck && npm --prefix document-service run typecheck && npm --prefix public-api-service run typecheck && npm --prefix mobile-service run typecheck",
    "check:service-routes": "node scripts/check-service-routes.mjs",
    "test:service-routes": "node --test scripts/check-service-routes.test.mjs",
    "cli:manifest":"tsx scripts/gen-admin-manifest.ts",
    "cli:check": "tsx scripts/gen-admin-manifest.ts --check",
    "cli:build": "node packages/cli/build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1038.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "3.1071.0",
    "@aws-sdk/client-rds": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.477.0",
    "@aws-sdk/client-secrets-manager": "^3.1110.0",
    "@aws-sdk/client-socialmessaging": "3.1071.0",
    "@aws-sdk/rds-signer": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@babel/parser": "^7.29.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/model-viewer": "4.3.1",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "1.0.10",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.2",
    "@opentelemetry/instrumentation": "^0.223.2",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/papaparse": "5.3.16",
    "@vercel/otel": "^2.1.3",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "bcrypt": "^6.0.0",
    "blurhash": "^2.0.5",
    "bwip-js": "^4.10.1",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.9.3",
    "jose": "^6.1.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.14.0",
    "mailauth": "^8.1.0",
    "mailparser": "^3.15.0",
    "motion": "^13.4.6",
    "next": "^15.5.29",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.6.1",
    "openai": "^6.37.0",
    "otplib": "^13.4.0",
    "papaparse": "5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^6.1.6",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "^18.2.0",
    "react-blurhash": "^0.3.0",
    "react-dom": "^18.2.0",
    "replicate": "^1.4.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.1",
    "twilio": "^6.0.2",
    "unicode-emoji-json": "^0.8.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^5.0.2",
    "@types/bwip-js": "^3.2.3",
    "@types/google.maps": "^3.64.0",
    "@types/ioredis": "^4.28.10",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20.10.6",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.17",
    "concurrently": "^10.0.6",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.29",
    "happy-dom": "^21.0.4",
    "msw": "^2.14.6",
    "null-loader": "^4.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "axios": "^1.20.0",
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^2.0.0": "^2.1.7",
    "brace-expansion@^5.0.0": "^5.0.12",
    "ip-address": "^10.7.4",
    "uuid": "^11.1.1",
    "next": {
      "postcss": "$postcss"
    },
    "readdir-glob": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "messaging-service",
    "document-service",
    "public-api-service",
    "mobile-service",
    "packages/*"
  ]
}
