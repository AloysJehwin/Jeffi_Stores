{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./controller-service/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "controller-service/.next/types/**/*.ts", "next-env.d.ts"],
  "exclude": ["node_modules", "ai-platform", "packages", "messaging-service", "document-service", "public-api-service"]
}
