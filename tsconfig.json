{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./packages/store-core/src/*"],
      "@controller/*": ["./controller-service/src/*"],
      "@storefront/*": ["./storefront-service/src/*"],
      "@admin/*": ["./admin-service/src/*"],
      "@business/*": ["./business-service/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts"],
  "exclude": ["node_modules", "ai-platform", "packages/api-contracts", "packages/bulk", "packages/design-tokens", "packages/draft-locks", "packages/gst", "packages/list-filters", "packages/mail-shell", "packages/pricing", "packages/push", "packages/service-auth", "packages/tenancy", "packages/wallet", "messaging-service", "document-service", "public-api-service", "mobile-service"]
}
