{
  "name": "mobile-service",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "predev": "SM_SECRET_ID=${SM_SECRET_ID:-jeffi/mobile/local} ENV_OUT_DIR=. node ../deploy/load-secrets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1110.0",
    "@fastify/rate-limit": "^10.2.1",
    "@jeffi/tenancy": "*",
    "fastify": "^5.12.8",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "tsx": "^4.19.2",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
