{
  "name": "document-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "predev": "SM_SECRET_ID=${SM_SECRET_ID:-jeffi/services/local} ENV_OUT_DIR=. node ../deploy/load-secrets.mjs"
  },
  "dependencies": {
    "@jeffi/api-contracts": "*",
    "@jeffi/pricing": "*",
    "@jeffi/service-auth": "*",
    "@jeffi/wallet": "*",
    "@jeffi/gst": "*",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.0",
    "pdfkit": "^0.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
