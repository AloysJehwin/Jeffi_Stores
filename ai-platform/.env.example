# AI Platform gateway env (copy to a k8s Secret/ConfigMap; never commit real values).

# App side (Next.js) needs ONLY this:
AI_GATEWAY_URL=http://ai-gateway.ai-platform.svc.cluster.local

# Gateway side:
PORT=8080
OLLAMA_BASE_URL=http://ollama:11434
PADDLE_OCR_URL=http://paddleocr:8866
REDIS_URL=redis://ai-redis:6379
OLLAMA_REQUEST_TIMEOUT_MS=120000

# Models (by hint)
OLLAMA_AGENT_MODEL=qwen2.5:7b
OLLAMA_SQL_MODEL=gemma4:12b
OLLAMA_COPY_MODEL=gemma4:12b
OLLAMA_EMAIL_MODEL=gemma3:4b
OLLAMA_FAST_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma4:12b
RAG_EMBED_MODEL=nomic-embed-text

# Durable queue
AI_JOB_ATTEMPTS=3
AI_WORKER_CONCURRENCY=2

# Semantic cache backing store (pgvector: the ai_cache table)
AI_CACHE_PG_URL=

# OpenAI escape hatch (only when a request forces provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Images and video
AI_IMAGE_PROVIDERS=razer,google,replicate
AI_VIDEO_PROVIDERS=google,replicate
AI_PUBLIC_URL=
AI_IMAGE_CACHE_TTL_SECONDS=3600
AI_FILES_TTL_SECONDS=3600
AI_VIDEO_TTL_SECONDS=86400
AI_VIDEO_POLL_MS=10000
AI_USD_INR=84
AI_PRICES_JSON=
SD_WEBUI_URL=
SD_MODEL=
SD_STEPS=25
SD_CFG=7
SD_SAMPLER=DPM++ 2M Karras
SD_TIMEOUT_MS=180000
GOOGLE_AI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_IMAGE_PREMIUM_MODEL=gemini-3-pro-image
GOOGLE_IMAGEN_MODEL=
GOOGLE_VEO_MODEL=veo-3.1-fast-generate-preview
GOOGLE_VEO_FALLBACK=veo-3.0-generate-001
GOOGLE_TIMEOUT_MS=120000
REPLICATE_API_TOKEN=
REPLICATE_TIMEOUT_MS=180000
# Cutout model for transparent-background images (owner/name, or owner/name:version).
REPLICATE_BG_REMOVAL_MODEL=bria/remove-background

# Claude text (Anthropic). Order of text providers; empty = anthropic,razer when Claude auth is set.
AI_TEXT_PROVIDERS=
# Production: workload identity federation. Org id + projected k8s token file here; each store's
# workspace / service account / federation rule ids come per request (ai_provider_identities).
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=
ANTHROPIC_FEDERATION_AUDIENCE=https://api.anthropic.com
# Local dev only: static key used when a request carries no store identity.
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-sonnet-5-5
ANTHROPIC_AGENT_EFFORT=medium
ANTHROPIC_SQL_MODEL=
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_COPY_MODEL=claude-haiku-5-5
ANTHROPIC_EMAIL_MODEL=
ANTHROPIC_ENRICH_MODEL=
ANTHROPIC_DEEP_MODEL=claude-opus-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
ANTHROPIC_FALLBACKS=default
ANTHROPIC_TIMEOUT_MS=120000
ANTHROPIC_MIN_MAX_TOKENS=8000
