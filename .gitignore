# TypeScript
*.tsbuildinfo
next-env.d.ts


# Temporary scripts & guides
*.sh
# ...but CI helper scripts MUST be committed — the workflows check them out and
# run them on the runner, so an ignored script means "No such file" in Actions.
!.github/scripts/*.sh
/scripts/
*.csv
RDS_SECURITY_GROUP_FIX.md
ADD_IP_TO_SECURITY_GROUP.md
EMAIL_NOTIFICATION_SYSTEM.md
QUICKSTART.md
S3_SETUP_INSTRUCTIONS.md
SECURITY_GROUP_INSTRUCTIONS.md

# AWS config files
s3-bucket-policy*.json

# Supabase CLI local state
supabase/.temp

# Google Service Account key
jeffi-stores-*.json

# Production env
.env.production

# Business documents (keep local, don't commit)
GST Certificate*.pdf
INV*.pdf
# pg_dump artifact (regenerate via database/schema/README.md)
database/schema-live.sql

# Personal notes (career planning, scratch docs)
ML_JOURNEY.md

# Claude Code runtime files
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Claude-generated planning/architecture docs (not checked in)
docs/MULTI_TENANT_ARCHITECTURE.md
docs/MULTI_TENANT_PHASES.md

# Graphify dated snapshot directories (regenerated on demand)
graphify-out/20*/

# Playwright MCP artifacts
.playwright-mcp/

# MCP server config — contains credentials, keep local only
.mcp.json

# On-device model training data (regenerated via scripts/gen-onboarding-dataset.mjs)
data/onboarding/

# On-device model weights (large; host on CDN/S3 in prod — regenerate via scripts/train+export)
public/models/onboarding/onnx/*.onnx

# On-device ORT runtime WASM (large; served from public/ or CDN in prod — copy from node_modules/onnxruntime-web/dist)
public/ort/*.wasm
public/ort/*.map
public/models/onboarding/ort/*.wasm
public/models/onboarding/ort/*.mjs


# IDE state (holds local diff caches; never commit)
.idea/
